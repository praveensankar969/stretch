{
  "name": "stretch",
  "version": "2.0.0",
  "description": "A little room to move. Thoughtful, private stretch breaks for macOS.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run guide:build",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/test-ui.cjs",
    "pretest:ui": "npm run guide:build",
    "postinstall": "node scripts/build-icons.mjs && node scripts/build-guide.mjs",
    "icons": "node scripts/build-icons.mjs",
    "guide:build": "node scripts/build-guide.mjs",
    "prebuild": "npm run icons && npm run guide:build",
    "build": "electron-builder --mac",
    "prebuild:mac": "npm run icons && npm run guide:build",
    "build:mac": "electron-builder --mac",
    "build:mac:dir": "npm run icons && npm run guide:build && electron-builder --mac --dir",
    "build:win": "npm run icons && npm run guide:build && electron-builder --win",
    "site:preview": "node scripts/serve-site.cjs",
    "prebuild:mac:local": "npm run icons && npm run guide:build",
    "build:mac:local": "electron-builder --mac dmg --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "character:build": "node scripts/build-character-preview.mjs",
    "character:preview": "node scripts/serve-character.cjs",
    "precharacter:preview": "npm run character:build",
    "character:test": "node scripts/test-character.cjs",
    "precharacter:test": "npm run character:build"
  },
  "author": {
    "name": "Stretch",
    "email": "sankar_praveen@hotmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "playwright": "^1.62.1",
    "png-to-ico": "^2.1.8",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "three": "0.186.1"
  },
  "build": {
    "appId": "com.stretchapp.in",
    "productName": "Stretch",
    "artifactName": "Stretch-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**/*",
      "!src/vendor/**",
      "!src/assets/lottie/**",
      "!src/guide/*.mjs",
      "!src/**/*.map"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Stretch",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Stretch"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "praveensankar969",
        "repo": "Stretch"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.healthcare-fitness",
      "hardenedRuntime": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "MIT — Stretch"
      }
    },
    "dmg": {
      "title": "Stretch",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
